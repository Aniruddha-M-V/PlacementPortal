# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB ────────────────────────────────────────────────────────────────────
# REQUIRED. Use MONGODB_URI — this is the ONLY accepted variable name.
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placementPortal
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/placementPortal?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────────────────────
# REQUIRED. Use a long random string. Never expose to frontend.
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS / Frontend URL ────────────────────────────────────────────────────────
# REQUIRED. Set to your deployed frontend URL.
# Comma-separate multiple origins if needed (e.g. production + local dev):
# FRONTEND_URL=https://portal.vvce.ac.in,http://localhost:5173
FRONTEND_URL=https://your-frontend-domain.com

# ─── Cloudinary (optional — resume/photo upload) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Admin Seed Account ──────────────────────────────────────────────────────────
# Used ONLY on first run when the users collection is empty.
# Change these before deploying. Not used if an admin already exists.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@your-institution.ac.in
ADMIN_PASSWORD=ChangeThisImmediately@2024
